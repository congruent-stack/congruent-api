{
  "name": "@congruent-stack/congruent-api-cli",
  "type": "module",
  "version": "0.18.0",
  "description": "Typescript schema-first tooling for agnostic REST APIs.",
  "keywords": [],
  "author": "congruent-stack",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "files": [
    "dist"
  ],
  "bin": {
    "congruent-api": "./dist/cli.mjs"
  },
  "exports": {
    "import": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "dependencies": {
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pkgroll": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "pkgroll --clean-dist"
  }
}
